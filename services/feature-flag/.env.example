# Environment
NODE_ENV=development

# Application Configuration
GRPC_PORT=50052
REST_PORT=50053
LOG_LEVEL=info

# Database Configuration
ROOT_DB_URL=postgresql://user:password@localhost:5432/postgres
FEATURE_FLAG_DB_URL=postgresql://user:password@localhost:5432/feature_flag_db

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TIMEOUT=300

# Security Configuration
DEFAULT_API_KEY=dev-feature-flag-api-key-12345
CORS_ORIGIN=*

# Feature Flags
ANALYTICS_ENABLED=true
USAGE_TRACKING=true
